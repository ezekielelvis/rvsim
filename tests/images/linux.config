# Linux 6.12 configuration for rvsim (a defconfig: unlisted options take
# their Kconfig defaults). One RV64IMAC hart, Sv39, no FPU; console on the
# 16550 UART, root on an initramfs or on ext4 over virtio-blk; no modules
# or network.
CONFIG_LOCALVERSION="-rvsim"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="rvsim"
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
# CONFIG_SMP is not set
# CONFIG_FPU is not set
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
# EFI stays enabled: portable kernels (no NONPORTABLE) select it. It is
# inert without UEFI firmware.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_COMPAT is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_NET is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_MMC is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_ACPI is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SIFIVE_PLIC=y
CONFIG_BLOCK=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=y
# Symbols and frame pointers for debugging with GDB (vmlinux; the Image
# itself does not carry debug info).
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_FRAME_POINTER=y
# CONFIG_DEBUG_MISC is not set
