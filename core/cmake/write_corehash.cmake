# Writes a Go source file holding the SHA-256 of the core library, so the Go
# package that links it via cgo is rebuilt and relinked whenever it changes.
# Go's build cache tracks Go sources and flags, not libraries named in
# #cgo LDFLAGS, so without this a C++-only change could leave go build and
# go test running the old core.
#
# Inputs: LIB (library path), OUT (Go file to write).
file(SHA256 "${LIB}" hash)
# The hash must reach the compiled package, not just its source: Go keys
# downstream links on the compiled archive, so an unused constant would
# change nothing. Setting a variable in init() puts it in the object code.
set(content "// Code generated by core/cmake/write_corehash.cmake; DO NOT EDIT.

package machine

func init() { coreLibHash = \"${hash}\" }
")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
